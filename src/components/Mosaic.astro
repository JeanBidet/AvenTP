---
/**
 * Allée en mosaïque : chaque réalisation type est une dalle photo,
 * les autres dalles sont en pierre. La géométrie est calculée au build
 * (src/lib/mosaic.ts) à partir de la configuration (src/data/mosaic.ts).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { generateMosaic, type MosaicConfig } from "../lib/mosaic";

export interface MosaicItem {
  title: string;
  text: string;
  href: string;
  img: ImageMetadata;
  alt: string;
}

interface Props {
  config: MosaicConfig;
  items: MosaicItem[];
  class?: string;
  /**
   * `fixe` : la zone est dessinée à sa taille en pixels, centrée, et rognée par la
   * largeur de l'écran. Les dalles gardent donc la même taille sur tous les écrans ;
   * un écran plus large montre une allée plus longue, avec plus de pavés.
   * `elastique` : la zone s'étire à la largeur disponible, tout grossit ensemble.
   */
  taille?: "fixe" | "elastique";
}

const { config, items, class: className, taille = "elastique" } = Astro.props;
const fixe = taille === "fixe";
const m = generateMosaic(config);
const box = (s: { left: number; top: number; width: number; height: number }) =>
  `left:${s.left}%;top:${s.top}%;width:${s.width}%;height:${s.height}%`;
/** Largeur d'affichage d'une dalle, en px si l'échelle est fixe (sert à `sizes`). */
const pxWidth = (s: { width: number }) => Math.round((s.width / 100) * m.width);
---

<!--
  Deux boîtes : celle de dehors est à la largeur de l'écran et rogne ; celle de dedans
  porte la zone de dessin, à taille fixe ou étirée. Les dalles sont positionnées en
  pourcentages de la boîte de dedans, donc un seul et même calcul sert aux deux modes.
-->
<div
  class:list={["relative w-full overflow-hidden bg-ink", className]}
  style={fixe ? `height:${m.height}px` : `aspect-ratio:${m.width} / ${m.height}`}
>
<div
  class="absolute top-0 left-1/2 -translate-x-1/2 [container-type:inline-size]"
  style={fixe ? `width:${m.width}px;height:${m.height}px` : "width:100%;height:100%"}
>
  {m.stones.map((s) => {
    if (!s.photo) {
      return (
        <div aria-hidden="true" class="absolute drop-shadow-[0_5px_6px_rgba(0,0,0,0.5)]" style={box(s)}>
          <div class="stone-flat size-full" style={`clip-path:polygon(${s.clip})`} />
        </div>
      );
    }
    const item = items[s.photo.index];
    if (!item) return null;
    const num = String(s.photo.index + 1).padStart(2, "0");
    return (
      <a
        href={item.href}
        class="group absolute block drop-shadow-[0_5px_6px_rgba(0,0,0,0.5)] hover:text-white"
        style={box(s)}
      >
        <div class="stone-flat absolute inset-0" style={`clip-path:polygon(${s.clip})`} />
        <div class="absolute inset-0 overflow-hidden" style={`clip-path:polygon(${s.photo.clipInner})`}>
          <Image
            src={item.img}
            alt={item.alt}
            widths={fixe ? [pxWidth(s), pxWidth(s) * 2] : [400, 640, 900]}
            sizes={fixe ? `${pxWidth(s)}px` : "(min-width: 768px) 32vw, 90vw"}
            class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <span
          class="absolute flex -translate-x-1/2 -translate-y-1/2 items-baseline gap-2.5 rounded-full bg-ink px-[1.1em] py-[0.55em] whitespace-nowrap transition-colors group-hover:bg-accent"
          style={`left:${s.photo.labelX}%;top:${s.photo.labelY}%;font-size:clamp(14px, 1.55cqw, 22px)`}
        >
          <span class="font-display text-[0.65em] font-semibold text-accent group-hover:text-ink">{num}</span>
          <span class="font-display leading-tight font-bold group-hover:text-ink">{item.title}</span>
          <span class="sr-only">— {item.text}</span>
        </span>
      </a>
    );
  })}
</div>
</div>
