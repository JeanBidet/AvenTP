---
/**
 * Diaporama des réalisations mises en avant (featured: true), piloté par Embla.
 * Le HTML est complet sans JS (scroll horizontal natif) ; Embla ajoute
 * le glissé, la boucle infinie, la lecture automatique et les points.
 */
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"realisations">[];
}
const { projects } = Astro.props;
---

<div data-carousel aria-roledescription="carrousel" aria-label="Chantiers récents">
  <div class="mb-6 flex justify-end gap-2.5">
    <button type="button" data-prev aria-label="Réalisation précédente"
      class="grid size-12 cursor-pointer place-items-center rounded-full border border-line-strong bg-ink transition-colors hover:border-accent">
      <Icon name="arrow-left" strokeWidth={2} />
    </button>
    <button type="button" data-next aria-label="Réalisation suivante"
      class="grid size-12 cursor-pointer place-items-center rounded-full bg-accent text-ink transition-colors hover:bg-accent-hover">
      <Icon name="arrow-right" strokeWidth={2} />
    </button>
  </div>

  <!-- Viewport : overflow caché ; le conteneur flex glisse à l'intérieur. -->
  <div data-viewport class="overflow-x-auto [scrollbar-width:none] [.is-ready_&]:overflow-hidden">
    <ul class="-ml-6 flex touch-pan-y">
      {projects.map((p, i) => (
        <li
          class="min-w-0 shrink-0 grow-0 basis-[85%] pl-6 sm:basis-1/2 lg:basis-1/3"
          aria-roledescription="diapositive"
          aria-label={`${i + 1} sur ${projects.length}`}
        >
          <ProjectCard project={p} />
        </li>
      ))}
    </ul>
  </div>

  <div data-dots class="mt-6 flex justify-center gap-1"></div>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  const DELAY = 4000;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      const viewport = root.querySelector<HTMLElement>("[data-viewport]")!;
      const dotsBox = root.querySelector<HTMLElement>("[data-dots]")!;

      root.classList.add("is-ready");
      const embla = EmblaCarousel(viewport, { loop: true, align: "start" });

      root.querySelector("[data-prev]")!.addEventListener("click", () => { embla.scrollPrev(); restart(); });
      root.querySelector("[data-next]")!.addEventListener("click", () => { embla.scrollNext(); restart(); });

      // Points : un par « snap » (position d'arrêt) calculé par Embla.
      const buildDots = () => {
        const snaps = embla.scrollSnapList();
        dotsBox.replaceChildren(
          ...snaps.map((_, i) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "grid size-11 cursor-pointer place-items-center";
            b.setAttribute("aria-label", `Aller à la position ${i + 1} sur ${snaps.length}`);
            const bar = document.createElement("span");
            bar.className = "block h-2 w-2 rounded-full bg-neutral-600 transition-all duration-300";
            b.append(bar);
            b.addEventListener("click", () => { embla.scrollTo(i); restart(); });
            return b;
          }),
        );
        syncDots();
      };
      const syncDots = () => {
        const selected = embla.selectedScrollSnap();
        [...dotsBox.children].forEach((b, i) => {
          const on = i === selected;
          b.setAttribute("aria-current", String(on));
          const bar = b.firstElementChild as HTMLElement;
          bar.classList.toggle("w-7", on);
          bar.classList.toggle("bg-accent", on);
          bar.classList.toggle("w-2", !on);
          bar.classList.toggle("bg-neutral-600", !on);
        });
      };
      embla.on("init", buildDots).on("reInit", buildDots).on("select", syncDots);
      buildDots();

      // Lecture automatique, en pause au survol, au focus clavier et onglet caché.
      let timer: number | undefined;
      let paused = false;
      const start = () => {
        if (reduceMotion || timer) return;
        timer = window.setInterval(() => {
          if (!paused && !document.hidden) embla.scrollNext();
        }, DELAY);
      };
      const stop = () => { clearInterval(timer); timer = undefined; };
      function restart() { stop(); start(); }

      root.addEventListener("mouseenter", () => (paused = true));
      root.addEventListener("mouseleave", () => (paused = false));
      root.addEventListener("focusin", () => (paused = true));
      root.addEventListener("focusout", () => (paused = false));
      embla.on("pointerDown", () => (paused = true));
      embla.on("pointerUp", () => (paused = false));

      start();
      // Nettoyage avant de quitter la page (View Transitions).
      document.addEventListener("astro:before-swap", () => { stop(); embla.destroy(); }, { once: true });
    });
  });
</script>
