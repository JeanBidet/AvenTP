---
import Icon from "./Icon.astro";
import { site } from "../data/site";

/**
 * Bloc contact de l'accueil : coordonnées et renvoi vers /devis.
 *
 * Le formulaire vivait ici avant d'avoir sa propre page. Il n'a pas été dupliqué :
 * deux formulaires aux champs différents finissent toujours par diverger, et le
 * visiteur qui remplit le plus court prive l'entreprise du budget et du type de
 * chantier.
 */
---

<section id="contact" class="bg-surface pt-20 pb-16 lg:pt-28" aria-labelledby="contact-title">
  <div class="container-site grid gap-14 lg:grid-cols-2 lg:gap-24">
    <div class="flex flex-col gap-9">
      <div class="flex flex-col gap-3.5">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title" class="font-display text-[34px] font-bold tracking-tight lg:text-[44px]">Parlons de votre projet</h2>
      </div>

      <address class="flex flex-col gap-5 text-[17px] not-italic">
        <a href={site.phoneHref} class="flex items-center gap-4 hover:text-accent"><Icon name="phone" class="size-5.5 shrink-0 text-accent" />{site.phone}</a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-4 hover:text-accent"><Icon name="mail" class="size-5.5 shrink-0 text-accent" />{site.email}</a>
        <span class="flex items-center gap-4"><Icon name="pin" class="size-5.5 shrink-0 text-accent" />{site.address}</span>
      </address>

      <div class="flex flex-col gap-3.5">
        <p class="text-sm text-neutral-400">Suivez nos chantiers</p>
        <ul class="flex gap-3">
          {site.socials.map((s) => (
            <li>
              <a href={s.href} aria-label={s.name}
                class="grid size-12 place-items-center rounded-full border border-line-strong transition-colors hover:border-accent hover:text-accent">
                <Icon name={s.icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-start gap-6 rounded-2xl border border-line bg-card p-8 lg:p-11">
      <h3 class="font-display text-2xl font-bold tracking-tight lg:text-[28px]">Demander un devis</h3>
      <p class="text-[17px] leading-relaxed text-muted">
        Quelques questions sur le type d'aménagement, la surface et le budget envisagé :
        de quoi vous rappeler avec une première idée du chantier plutôt qu'avec une page
        blanche.
      </p>
      <ul class="flex flex-col gap-2.5 text-[15px] text-muted">
        <li class="flex items-center gap-3"><Icon name="check" class="size-4.5 shrink-0 text-accent" strokeWidth={2.5} />Réponse par téléphone ou par email</li>
        <li class="flex items-center gap-3"><Icon name="check" class="size-4.5 shrink-0 text-accent" strokeWidth={2.5} />Visite et prise de côtes sur place</li>
        <li class="flex items-center gap-3"><Icon name="check" class="size-4.5 shrink-0 text-accent" strokeWidth={2.5} />Devis détaillé poste par poste</li>
      </ul>
      <a href="/devis" class="btn-accent mt-1">
        Remplir le formulaire <Icon name="arrow-right" class="size-4.5" strokeWidth={2} />
      </a>
    </div>
  </div>
</section>
