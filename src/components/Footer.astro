---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-surface">
  <div class="container-site">
    <div class="flex flex-wrap justify-between gap-6 border-t border-neutral-800 pt-8 pb-24 text-sm lg:pb-8 text-neutral-400">
      <span>© {year} {site.name} — Terrassement &amp; Aménagement extérieur</span>
      <nav aria-label="Informations légales" class="flex gap-7">
        <a href="/mentions-legales" class="hover:text-accent">Mentions légales</a>
        <a href="/confidentialite" class="hover:text-accent">Politique de confidentialité</a>
      </nav>
    </div>
  </div>
</footer>
