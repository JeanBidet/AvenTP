---
/**
 * Page de texte (mentions légales, confidentialité) : un titre, une date de mise à
 * jour, et le contenu dans une colonne étroite. Les styles du texte viennent de
 * l'utilitaire `prose-site` (src/styles/global.css).
 */
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-neutral-800 pt-16 pb-8 lg:pt-24 lg:pb-12">
    <div class="container-site flex flex-col gap-4">
      <p class="eyebrow">Informations légales</p>
      <h1 class="font-display text-[38px] leading-none font-bold tracking-tighter lg:text-[56px]">{title}</h1>
      <p class="text-sm text-faint">Dernière mise à jour : {updated}</p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="container-site">
      <div class="prose-site max-w-[760px]">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
