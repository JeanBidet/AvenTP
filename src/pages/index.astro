---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Carousel from "../components/Carousel.astro";
import CtaBand from "../components/CtaBand.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";

import hero from "../assets/img/hero-terrasse-jardin.jpg";
import imgAllee from "../assets/img/allee-gravier-dalles.jpg";
import imgTerrasse from "../assets/img/illu-terrasse.svg";
import imgJardin from "../assets/img/illu-jardin.svg";
import imgCloture from "../assets/img/illu-cloture.svg";
import imgPiscine from "../assets/img/piscine-plage-pierre.jpg";

// Réalisations types : chaque image a sa « découpe » (border-radius par coin : HG HD BD BG).
// Une valeur énorme (999px) est ramenée au maximum possible → demi-cercle.
const types = [
  { title: "Allées", text: "Pavés, dalles, gravier stabilisé ou béton désactivé.", img: imgAllee,
    alt: "Allée en gravier bordée de dalles", shape: "rounded-[999px_999px_16px_16px]", filter: "allees" },
  { title: "Terrasses", text: "Bois, composite, pierre ou carrelage sur plot.", img: imgTerrasse,
    alt: "Illustration d'une terrasse en bois sous pergola", shape: "rounded-[16px_120px_16px_16px]", filter: "terrasses" },
  { title: "Jardins", text: "Engazonnement, plantations, massifs et haies.", img: imgJardin,
    alt: "Illustration d'un jardin avec pelouse, haie et massif fleuri", shape: "rounded-full", filter: "jardins" },
  { title: "Clôtures", text: "Clôtures, portails, brise-vue et murets.", img: imgCloture,
    alt: "Illustration d'une clôture à lames anthracite", shape: "rounded-[120px_16px_16px_16px]", filter: "clotures" },
  { title: "Piscines", text: "Terrassement de la fosse, plages et abords.", img: imgPiscine,
    alt: "Piscine entourée d'une plage en pierre", shape: "rounded-[16px_16px_999px_999px]", filter: "piscines" },
];

// Diaporama : les chantiers marqués « featured: true », triés par « order ».
const featured = (await getCollection("realisations", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero : photo panoramique atténuée (opacity) sur fond vert très sombre -->
  <section class="relative flex min-h-[560px] items-end overflow-hidden bg-[#0b1f1e] lg:min-h-[640px]">
    <Image
      src={hero}
      alt=""
      loading="eager"
      fetchpriority="high"
      widths={[738]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover opacity-60"
    />
    <div class="container-site relative">
      <div class="mb-8 flex w-full max-w-[640px] animate-fade-up flex-col gap-5 border-t-6 border-accent bg-ink px-7 py-8 lg:mb-16 lg:px-12 lg:py-11">
        <p class="text-[13px] font-semibold tracking-[2px] text-accent uppercase">Paysagisme · Terrassement</p>
        <h1 class="font-display text-[32px] leading-[1.05] font-bold tracking-tight sm:text-[40px] lg:text-[52px]">
          Aménager vos extérieurs, du terrain brut au jardin fini.
        </h1>
        <p class="text-[17px] text-muted">
          [Phrase d'accroche : zone d'intervention, savoir-faire, type de clientèle — particuliers, professionnels, collectivités.]
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#contact" class="btn-accent">Demander un devis</a>
          <a href="/realisations" class="btn-outline">Voir nos réalisations</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Réalisations types -->
  <section id="services" class="py-20 lg:py-30" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHeading eyebrow="Nos métiers" title="Ce que nous réalisons" id="services-title">
        <p class="max-w-[440px] text-muted">
          Du terrassement préparatoire jusqu'aux finitions paysagères, AvenTP prend en charge l'ensemble de votre projet extérieur.
        </p>
      </SectionHeading>

      <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 xl:grid-cols-5 xl:gap-6">
        {types.map((t, i) => (
          <li class="reveal" style={`animation-delay: ${i * 80}ms`}>
            <a href={`/realisations#${t.filter}`} class="group flex flex-col gap-4.5 hover:text-white">
              <div class:list={["overflow-hidden", t.shape]}>
                <Image
                  src={t.img}
                  alt={t.alt}
                  widths={[300, 500]}
                  sizes="(min-width: 1280px) 250px, (min-width: 640px) 33vw, 50vw"
                  class="h-[220px] w-full object-cover transition-transform duration-500 group-hover:scale-105 lg:h-[300px]"
                />
              </div>
              <div>
                <div class="flex items-baseline gap-2.5">
                  <span class="font-display text-sm font-semibold text-accent">{String(i + 1).padStart(2, "0")}</span>
                  <h3 class="font-display text-2xl font-bold group-hover:text-accent">{t.title}</h3>
                </div>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.text}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Chantiers récents : diaporama -->
  <section id="realisations" class="pb-20 lg:pb-30" aria-labelledby="recent-title">
    <div class="container-site">
      <SectionHeading eyebrow="Réalisations" title="Quelques chantiers récents" id="recent-title">
        <a href="/realisations" class="inline-flex items-center gap-2 border-b-2 border-accent py-3 font-semibold">
          Toutes les réalisations <Icon name="arrow-right" class="size-4.5" strokeWidth={2} />
        </a>
      </SectionHeading>
      <Carousel projects={featured} />
    </div>
  </section>

  <CtaBand id="apropos" title="Un projet d'aménagement extérieur ?">
    [Présentation courte : années d'expérience, zone d'intervention, équipe, matériel.]
  </CtaBand>

  <Contact />
</BaseLayout>
