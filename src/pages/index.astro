---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Carousel from "../components/Carousel.astro";
import CtaBand from "../components/CtaBand.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";

import hero from "../assets/img/hero-terrasse-jardin.jpg";
import imgAllee from "../assets/img/allee-gravier-dalles.jpg";
import imgTerrasse from "../assets/img/illu-terrasse.svg";
import imgJardin from "../assets/img/illu-jardin.svg";
import imgCloture from "../assets/img/cloture-bois-pierre.jpg";
import imgPiscine from "../assets/img/piscine-plage-pierre.jpg";

// Réalisations types. Chaque image a sa silhouette courbe, définie plus bas par un
// <clipPath clipPathUnits="objectBoundingBox"> : les coordonnées vont de 0 à 1, donc la
// forme suit la taille de la carte, et les courbes de Bézier autorisent pointes et
// concavités — ce que `border-radius`, toujours convexe, ne permet pas.
const types = [
  { title: "Allées", text: "Pavés, dalles, gravier stabilisé ou béton désactivé.", img: imgAllee,
    alt: "Allée en gravier bordée de dalles", href: "/realisations#allees",
    forme: "forme-galet" },
  { title: "Terrasses", text: "Bois, composite, pierre ou carrelage sur plot.", img: imgTerrasse,
    alt: "Illustration d'une terrasse en bois sous pergola", href: "/realisations#terrasses",
    forme: "forme-petale" },
  { title: "Jardins", text: "Engazonnement, plantations, massifs et haies.", img: imgJardin,
    alt: "Illustration d'un jardin avec pelouse, haie et massif fleuri", href: "/realisations#jardins",
    forme: "forme-haricot" },
  { title: "Clôtures", text: "Clôtures, portails, brise-vue et murets.", img: imgCloture,
    alt: "Clôture en lames de bois entre des piliers en pierre", href: "/realisations#clotures",
    forme: "forme-arche" },
  { title: "Piscines", text: "Terrassement de la fosse, plages et abords.", img: imgPiscine,
    alt: "Piscine entourée d'une plage en pierre", href: "/realisations#piscines",
    forme: "forme-goutte" },
];

// Diaporama : les chantiers marqués « featured: true », triés par « order ».
const featured = (await getCollection("realisations", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero : photo panoramique atténuée (opacity) sur fond vert très sombre -->
  <section class="relative flex min-h-[560px] items-end overflow-hidden bg-[#0b1f1e] lg:min-h-[640px]">
    <Image
      src={hero}
      alt=""
      loading="eager"
      fetchpriority="high"
      widths={[738]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover opacity-60"
    />
    <div class="container-site relative">
      <div class="mb-8 flex w-full max-w-[640px] animate-fade-up flex-col gap-5 border-t-6 border-accent bg-ink px-7 py-8 lg:mb-16 lg:px-12 lg:py-11">
        <p class="text-[13px] font-semibold tracking-[2px] text-accent uppercase">Paysagisme · Terrassement</p>
        <h1 class="font-display text-[32px] leading-[1.05] font-bold tracking-tight sm:text-[40px] lg:text-[52px]">
          Aménager vos extérieurs, du terrain brut au jardin fini.
        </h1>
        <p class="text-[17px] text-muted">
          [Phrase d'accroche : zone d'intervention, savoir-faire, type de clientèle — particuliers, professionnels, collectivités.]
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#contact" class="btn-accent">Demander un devis</a>
          <a href="/realisations" class="btn-outline">Voir nos réalisations</a>
        </div>
      </div>
    </div>
  </section>

  <!--
    Silhouettes des vignettes de « Ce que nous réalisons ». `objectBoundingBox` fait
    travailler le chemin dans un carré de 0 à 1 que le navigateur étire à la taille de
    l'élément : une seule définition sert donc à toutes les largeurs de carte.
    Le SVG est de taille nulle — il ne sert qu'à porter les définitions — mais il ne
    doit pas être en `display:none`, sinon les références sont ignorées.
  -->
  <svg aria-hidden="true" focusable="false" class="pointer-events-none absolute size-0">
    <defs>
      <clipPath id="forme-galet" clipPathUnits="objectBoundingBox">
        <path d="M .46 .02 C .75 .01 .99 .22 .96 .5 C .93 .78 .7 .99 .43 .97 C .17 .95 .02 .72 .04 .44 C .06 .18 .22 .04 .46 .02 Z" />
      </clipPath>
      <clipPath id="forme-petale" clipPathUnits="objectBoundingBox">
        <path d="M .06 .06 C .4 0 .78 .06 .93 .28 C 1 .45 .98 .72 .78 .88 C .55 1.02 .2 .96 .08 .74 C 0 .55 0 .24 .06 .06 Z" />
      </clipPath>
      <clipPath id="forme-haricot" clipPathUnits="objectBoundingBox">
        <path d="M .34 .03 C .64 -.01 .9 .12 .95 .32 C .99 .47 .76 .5 .78 .64 C .8 .8 .98 .82 .92 .92 C .8 1.04 .36 1 .16 .84 C 0 .7 .02 .28 .12 .15 C .18 .08 .25 .04 .34 .03 Z" />
      </clipPath>
      <clipPath id="forme-arche" clipPathUnits="objectBoundingBox">
        <path d="M .04 .94 C .01 .58 .1 .18 .34 .06 C .57 -.05 .87 .05 .95 .3 C 1.02 .53 .98 .78 .96 .94 C .96 .98 .93 1 .88 1 L .12 1 C .06 1 .04 .98 .04 .94 Z" />
      </clipPath>
      <clipPath id="forme-goutte" clipPathUnits="objectBoundingBox">
        <path d="M .5 .04 C .76 .02 .95 .2 .96 .44 C .97 .66 .99 .88 .99 .97 C .99 .99 .97 1 .94 .99 C .7 .95 .3 .96 .14 .8 C 0 .66 .02 .3 .2 .13 C .3 .06 .4 .04 .5 .04 Z" />
      </clipPath>
    </defs>
  </svg>

  <!-- Réalisations types -->
  <section id="services" class="py-20 lg:py-30" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHeading eyebrow="Nos métiers" title="Ce que nous réalisons" id="services-title">
        <p class="max-w-[440px] text-muted">
          Du terrassement préparatoire jusqu'aux finitions paysagères, AvenTP prend en charge l'ensemble de votre projet extérieur.
        </p>
      </SectionHeading>

      <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 xl:grid-cols-5 xl:gap-6">
        {types.map((t, i) => (
          <li class="reveal" style={`animation-delay: ${i * 80}ms`}>
            <a href={t.href} class="group flex flex-col gap-4.5 hover:text-white">
              {/*
                Deux fois la même forme : le conteneur porte le liseré (fond clair, 2 px
                de marge) et la boîte intérieure, rétrécie d'autant, laisse voir un bord
                de pierre tout autour de la photo.
              */}
              <div class="bg-line-strong p-[2px]" style={`clip-path:url(#${t.forme})`}>
                <div style={`clip-path:url(#${t.forme})`}>
                  <Image
                    src={t.img}
                    alt={t.alt}
                    widths={[300, 500]}
                    sizes="(min-width: 1280px) 250px, (min-width: 640px) 33vw, 50vw"
                    class="h-[220px] w-full object-cover transition-transform duration-500 group-hover:scale-105 lg:h-[300px]"
                  />
                </div>
              </div>
              <div>
                <div class="flex items-baseline gap-2.5">
                  <span class="font-display text-sm font-semibold text-accent">{String(i + 1).padStart(2, "0")}</span>
                  <h3 class="font-display text-2xl font-bold group-hover:text-accent">{t.title}</h3>
                </div>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.text}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Chantiers récents : diaporama -->
  <section id="realisations" class="pb-20 lg:pb-30" aria-labelledby="recent-title">
    <div class="container-site">
      <SectionHeading eyebrow="Réalisations" title="Quelques chantiers récents" id="recent-title">
        <a href="/realisations" class="inline-flex items-center gap-2 border-b-2 border-accent py-3 font-semibold">
          Toutes les réalisations <Icon name="arrow-right" class="size-4.5" strokeWidth={2} />
        </a>
      </SectionHeading>
      <Carousel projects={featured} />
    </div>
  </section>

  <CtaBand id="apropos" title="Un projet d'aménagement extérieur ?">
    [Présentation courte : années d'expérience, zone d'intervention, équipe, matériel.]
  </CtaBand>

  <Contact />
</BaseLayout>
