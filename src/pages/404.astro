---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import fond from "../assets/img/chantier-implantation-allee.jpg";

/**
 * Page d'erreur 404. Astro la génère en dist/404.html : Netlify, Surge, Cloudflare
 * Pages, Apache (avec ErrorDocument) la servent d'eux-mêmes pour toute adresse
 * inconnue, au lieu de leur page d'erreur brute.
 *
 * Le clin d'œil (un chantier encore en coffrage) reste discret : le visiteur est
 * perdu, la page doit surtout lui redonner trois chemins utiles.
 */
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="relative isolate flex min-h-[75vh] items-center overflow-hidden bg-[#0b1f1e] py-20">
    <Image
      src={fond}
      alt=""
      widths={[640, 1024, 1536]}
      sizes="100vw"
      quality={60}
      class="absolute inset-0 -z-10 size-full object-cover opacity-30"
    />
    <div class="container-site flex flex-col items-start gap-6">
      <p class="eyebrow">Erreur 404</p>
      <h1 class="max-w-[14ch] font-display text-[40px] leading-[1.05] font-bold tracking-tight lg:text-[60px]">
        Cette page est encore en chantier.
      </h1>
      <p class="max-w-[48ch] text-[17px] text-muted">
        L'adresse demandée n'existe pas, ou la page a été déplacée. Voici par où
        reprendre :
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/" class="btn-accent">Retour à l'accueil</a>
        <a href="/realisations" class="btn-outline">Nos réalisations</a>
        <a href="/devis" class="btn-outline">Demander un devis</a>
      </div>
    </div>
  </section>
</BaseLayout>
