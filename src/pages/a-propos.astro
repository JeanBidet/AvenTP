---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import chantier from "../assets/img/allee-beton-courbe.jpg";

/**
 * Page de présentation, volontairement courte : qui c'est, ce qu'il sait faire,
 * ce qui le couvre, et où aller ensuite.
 *
 * Tout ce qui relève du parcours réel reste entre crochets : ce sont des
 * informations que seule l'entreprise a, et les inventer donnerait une biographie
 * fausse sur la page même censée établir la confiance.
 */

const chiffres = [
  { valeur: "[X]", libelle: "années de métier" },
  { valeur: "[X]", libelle: "chantiers livrés" },
  { valeur: "[X] km", libelle: "autour de [Ville]" },
];

const qualifications = [
  "[Diplôme — CAP, BP…]",
  "[CACES conduite d'engins]",
  "[Assurance décennale]",
  "[Responsabilité civile professionnelle]",
];
---

<BaseLayout
  title="À propos"
  description={`Qui est derrière ${site.name} : parcours et savoir-faire d'une entreprise de terrassement et d'aménagement extérieur.`}
>
  <section class="border-b border-neutral-800 pt-16 pb-8 lg:pt-24 lg:pb-12">
    <div class="container-site flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div class="flex flex-col gap-4">
        <p class="eyebrow">À propos</p>
        <h1 class="font-display text-[44px] leading-none font-bold tracking-tighter lg:text-[64px]">
          Qui est derrière {site.name}
        </h1>
      </div>
      <p class="max-w-[460px] text-[17px] text-muted">
        Un seul interlocuteur du premier coup de pelle au dernier pavé posé : celui qui chiffre votre chantier est celui qui le réalise.
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20" aria-labelledby="portrait-titre">
    <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
      {/*
        Emplacement du portrait, laissé vide plutôt que rempli par une photo
        d'agence : une tête d'inconnu sur une page qui raconte un vrai parcours se
        repère au premier coup d'œil. Le cadre tient déjà la proportion finale.
      */}
      <div class="flex aspect-[4/5] flex-col items-center justify-center gap-5 rounded-2xl border border-dashed border-line-strong bg-card px-8 text-center">
        <span class="h-px w-12 bg-line-strong" aria-hidden="true"></span>
        <p class="text-[15px] leading-relaxed text-faint">
          [PHOTO — portrait sur un chantier, cadrage vertical, 1200 × 1500 px environ.
          À déposer dans <code class="text-muted">src/assets/img/</code>.]
        </p>
      </div>

      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-2">
          <h2 id="portrait-titre" class="font-display text-[32px] leading-tight font-bold tracking-tight lg:text-[42px]">
            [Prénom Nom]
          </h2>
          <p class="text-[17px] font-semibold text-accent">Gérant</p>
        </div>

        <div class="flex max-w-[58ch] flex-col gap-5 text-[17px] leading-relaxed text-muted">
          <p>
            Formé par un [Diplôme — CAP, BP…], [Prénom] a passé
            [X] ans sur les chantiers d'autres entreprises : terrassements de lotissements,
            réseaux, puis aménagements extérieurs chez les particuliers. De quoi apprendre que
            la tenue d'une allée se joue sous terre, dans le fond de forme, bien avant la pose.
          </p>
          <p>
            En [Année], il crée {site.name} pour suivre lui-même chaque projet de bout en
            bout. Ce qu'il préfère : le moment où le client redécouvre un terrain qu'il ne
            savait pas comment utiliser, devenu une terrasse où l'on déjeune ou une allée où
            l'on ne se tord plus les chevilles.
          </p>
        </div>

        <dl class="mt-1 grid grid-cols-3 gap-x-6 border-t border-line pt-7">
          {chiffres.map((c) => (
            <div class="flex flex-col gap-1.5">
              <dt class="font-display text-[30px] leading-none font-bold tracking-tighter text-accent lg:text-[38px]">{c.valeur}</dt>
              <dd class="text-[14px] leading-snug text-muted">{c.libelle}</dd>
            </div>
          ))}
        </dl>

        <div class="flex flex-col gap-3.5 border-t border-line pt-7">
          <p class="text-sm text-neutral-400">Qualifications et assurances</p>
          <ul class="flex flex-wrap gap-2.5">
            {qualifications.map((q) => (
              <li class="rounded-full border border-line-strong px-4 py-2 text-[14px] text-muted">{q}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-[#0b1f1e]" aria-labelledby="voir-titre">
    <Image
      src={chantier}
      alt=""
      widths={[900, 1440]}
      sizes="100vw"
      quality={60}
      class="absolute inset-0 -z-10 size-full object-cover opacity-35"
    />
    <div class="container-site flex flex-col items-start gap-6 py-16 lg:py-24">
      <h2 id="voir-titre" class="max-w-[16ch] font-display text-[30px] leading-tight font-bold tracking-tight lg:text-[42px]">
        Le travail parle mieux que la page qui le décrit.
      </h2>
      <div class="flex flex-wrap gap-3">
        <a href="/realisations" class="btn-accent">Voir nos réalisations</a>
        <a href="/devis" class="btn-outline">Demander un devis</a>
      </div>
    </div>
  </section>
</BaseLayout>
